APP_NAME=Vehicle Maintenance Assistant
APP_ENV=development
# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/vehicle_maintenance
# Supabase (replace YOUR_PROJECT_REF and YOUR_PASSWORD):
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=
REDIS_URL=redis://localhost:6379/0
REMINDER_MILEAGE_THRESHOLD_KM=500
CHROMA_PERSIST_DIRECTORY=storage/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OCR_LANG=en
