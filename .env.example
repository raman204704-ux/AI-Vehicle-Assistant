APP_ENV=development
APP_UID=1000
APP_GID=1000
# For Docker Compose local PostgreSQL container:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
# Or use Supabase (set DATABASE_URL in backend/.env instead)
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=8080
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=
REDIS_URL=redis://redis:6379/0
REMINDER_MILEAGE_THRESHOLD_KM=500
CHROMA_PERSIST_DIRECTORY=storage/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OCR_LANG=en
